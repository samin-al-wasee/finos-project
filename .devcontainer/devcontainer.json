{
  "name": "FinOS (analysis & tests)",
  "build": {
    "dockerfile": "Dockerfile",
    "target": "lite"
  },

  // Named volumes rather than bind mounts: pub and drift's build_runner caches
  // are large and rebuilt often, and keeping them out of the workspace means a
  // container rebuild does not throw them away.
  "mounts": [
    "source=finos-pub-cache,target=/home/vscode/.pub-cache,type=volume",
    "source=finos-dart-tool,target=${containerWorkspaceFolder}/.dart_tool,type=volume"
  ],

  // .dart_tool is owned by the volume, so it starts empty and root-owned.
  "onCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.pub-cache ${containerWorkspaceFolder}/.dart_tool",

  // git refuses to operate on a repository owned by another user, which is what
  // a bind-mounted workspace looks like from inside the container.
  "postCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder} && flutter pub get",

  "customizations": {
    "vscode": {
      "extensions": ["Dart-Code.dart-code", "Dart-Code.flutter"],
      "settings": {
        "dart.flutterSdkPath": "/opt/flutter",
        // Matches the project's dart format defaults so the editor and CI agree.
        "editor.formatOnSave": true,
        "[dart]": {
          "editor.defaultFormatter": "Dart-Code.dart-code",
          "editor.rulers": [80]
        }
      }
    }
  },

  "remoteUser": "vscode"
}
